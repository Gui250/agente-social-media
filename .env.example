OPENAI_API_KEY=
# Optional: defaults to the Agents SDK default model
OPENAI_MODEL=

# Optional: models for AI-generated media (defaults: gpt-image-2, sora-2)
IMAGE_MODEL=
VIDEO_MODEL=

# Neon: use the pooled connection string (host with "-pooler")
DATABASE_URL=

# Post media: private Vercel Blob store. `vercel blob create-store <name> --access private --yes`
# adds this to the Vercel project and to .env.local.
BLOB_READ_WRITE_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
# Bearer token for /api/cron/* (min 16 chars). On Vercel, Vercel Cron sends it automatically.
CRON_SECRET=

# Facebook Login for Business (optional): connect all Instagram accounts linked to your Pages
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/instagram/facebook/callback
